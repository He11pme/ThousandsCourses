<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.ThousandsCourses.AppBar" parent="Widget.Material3.AppBarLayout">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="Widget.ThousandsCourses.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.ThousandsCourses.ToolbarTitle</item>
        <item name="contentInsetEnd">16dp</item>
        <item name="contentInsetStart">0dp</item>
    </style>

    <style name="Widget.ThousandsCourses.SearchBar" parent="Widget.Material3.SearchBar">
        <item name="materialThemeOverlay">@style/ThemeOverlay.ThousandsCourses.SearchView</item>
    </style>

    <style name="Widget.ThousandsCourses.Button.IconButton.Filled" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/white</item>
        <item name="backgroundTint">@color/dark_gray</item>
    </style>

    <style name="Widget.ThousandsCourses.Button.IconButton.Filled.Medium" />

    <style name="Widget.ThousandsCourses.Button.IconButton.Filled.Media">
        <item name="iconSize">26dp</item>
    </style>

    <style name="Widget.ThousandsCourses.Button.IconButton.Filled.Media.VK">
        <item name="icon">@drawable/ic_vk</item>
        <item name="backgroundTint">#2683ED</item>
    </style>

    <style name="Widget.ThousandsCourses.Button.IconButton.Filled.Media.OK">
        <item name="icon">@drawable/ic_ok</item>
        <item name="backgroundTint">#fa6602</item>
    </style>

    <style name="Widget.ThousandsCourses.FavoriteButton" parent="Widget.ThousandsCourses.Button.IconButton.Filled.Medium">
        <item name="backgroundTint">@color/glass</item>
        <item name="iconSize">16dp</item>
    </style>

    <style name="Widget.ThousandsCourses.BottomAppBar" parent="Widget.Material3.BottomAppBar.Legacy">
        <item name="android:layout_gravity">bottom</item>
        <item name="contentInsetStart">@dimen/content_inset_side_bottom_app_bar</item>
        <item name="contentInsetEnd">@dimen/content_inset_side_bottom_app_bar</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.ThousandsCourses.BottomAppBar</item>
    </style>

    <style name="Widget.ThousandsCourses.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="materialThemeOverlay">
            @style/ThemeOverlay.ThousandsCourses.BottomNavigationView
        </item>
        <item name="itemTextAppearanceActive">
            @style/ThemeOverlay.ThousandsCourses.BottomNavigationView
        </item>
        <item name="itemTextAppearanceInactive">
            @style/ThemeOverlay.ThousandsCourses.BottomNavigationView
        </item>
    </style>

    <style name="Widget.ThousandsCourses.InfoBadge" parent="">
        <item name="android:background">@drawable/br_rounded</item>
        <item name="android:clipToOutline">true</item>
        <item name="android:outlineProvider">background</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="Widget.ThousandsCourses.TextWithDrawable" parent="">
        <item name="android:drawablePadding">4dp</item>
    </style>

    <style name="Widget.ThousandsCourses.BottomSection.Item" parent="">
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="Widget.ThousandsCourses.BottomSection.Item.Description">
        <item name="android:alpha">0.7</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">2</item>
    </style>

    <style name="Widget.ThousandsCourses.TextInputLayoutLogin" parent="Widget.Material3.TextInputLayout.OutlinedBox">

        <item name="boxBackgroundColor">@color/light_gray</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="hintEnabled">false</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.ExtraExtraLarge</item>

    </style>

    <style name="Widget.ThousandsCourses.TextInputEditTextLogin" parent="Widget.AppCompat.EditText">

        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/white_50</item>
        <item name="android:textAppearance">@style/TextAppearance.ThousandsCourses.Body.Medium</item>


    </style>

    <style name="Widget.ThousandsCourses.ButtonLogin" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/green</item>
        <item name="android:textAppearance">@style/TextAppearance.ThousandsCourses.Button</item>
    </style>

    <style name="Widget.ThousandsCourses.ButtonWithDrawable.ChevronRight" parent="">
        <item name="android:textAppearance">@style/TextAppearance.ThousandsCourses.Button</item>
        <item name="android:drawableEnd">@drawable/ic_chevron_right</item>
    </style>


</resources>